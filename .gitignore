# Large binaries stay local-only and are never committed.
# ref: reference/README.md ("Large binaries stay local-only; never commit videos to git")
*.smk
*.mp4
*.avi
*.mkv
# Godot-generated local files: editor import cache, empty editor
# profile dirs, and build output.
game/.godot/
game/build/
game/export_templates/
game/feature_profiles/
game/script_templates/
game/text_editor_themes/
