[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
script = ExtResource("1_menu")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="VBoxContainer" parent="./Center"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="./Center/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 84
text = "REREBEL"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="./Center/Menu"]
layout_mode = 2
text = "Clean-room remake — vertical slice"
horizontal_alignment = 1

[node name="SideRow" type="HBoxContainer" parent="./Center/Menu"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="SideLabel" type="Label" parent="./Center/Menu/SideRow"]
layout_mode = 2
text = "Side"

[node name="SideButton" type="OptionButton" parent="./Center/Menu/SideRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="GalaxyRow" type="HBoxContainer" parent="./Center/Menu"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="GalaxyLabel" type="Label" parent="./Center/Menu/GalaxyRow"]
layout_mode = 2
text = "Galaxy Size"

[node name="GalaxySizeButton" type="OptionButton" parent="./Center/Menu/GalaxyRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="DifficultyRow" type="HBoxContainer" parent="./Center/Menu"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="DifficultyLabel" type="Label" parent="./Center/Menu/DifficultyRow"]
layout_mode = 2
text = "Difficulty"

[node name="DifficultyButton" type="OptionButton" parent="./Center/Menu/DifficultyRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="StartButton" type="Button" parent="./Center/Menu"]
custom_minimum_size = Vector2(300, 52)
layout_mode = 2
size_flags_horizontal = 4
text = "Start"

[node name="AboutButton" type="Button" parent="./Center/Menu"]
custom_minimum_size = Vector2(300, 52)
layout_mode = 2
size_flags_horizontal = 4
text = "About"

[node name="ExitButton" type="Button" parent="./Center/Menu"]
custom_minimum_size = Vector2(300, 52)
layout_mode = 2
size_flags_horizontal = 4
text = "Exit"

[node name="AboutDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "About ReRebel"
dialog_text = "ReRebel is a clean-room remake built for parity research. No original assets ship with this project."

[connection signal="pressed" from="Center/Menu/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Center/Menu/AboutButton" to="." method="_on_about_pressed"]
[connection signal="pressed" from="Center/Menu/ExitButton" to="." method="_on_exit_pressed"]
[connection signal="item_selected" from="Center/Menu/SideRow/SideButton" to="." method="_on_side_selected"]
[connection signal="item_selected" from="Center/Menu/GalaxyRow/GalaxySizeButton" to="." method="_on_galaxy_size_selected"]
[connection signal="item_selected" from="Center/Menu/DifficultyRow/DifficultyButton" to="." method="_on_difficulty_selected"]
