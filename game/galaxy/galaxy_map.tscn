[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://galaxy/galaxy_map.gd" id="1_map"]

[node name="GalaxyMap" type="Node2D"]
script = ExtResource("1_map")

[node name="Backdrop" type="CanvasLayer" parent="."]
layer = -1

[node name="Background" type="ColorRect" parent="./Backdrop"]
mouse_filter = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.06, 1)

[node name="UI" type="CanvasLayer" parent="."]

[node name="TopBar" type="HBoxContainer" parent="./UI"]
offsets_preset = 10
offset_left = 16.0
offset_top = 12.0
offset_right = 884.0
offset_bottom = 52.0
theme_override_constants/separation = 16

[node name="MenuButton" type="Button" parent="./UI/TopBar"]
layout_mode = 2
text = "Menu"

[node name="SettingsLabel" type="Label" parent="./UI/TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Settings"
vertical_alignment = 1

[node name="PiPGrid" type="Control" parent="./UI"]
unique_name_in_owner = true
mouse_filter = 2
offset_right = 900.0
offset_bottom = 720.0

[node name="Panel" type="PanelContainer" parent="./UI"]
anchors_preset = 2
anchor_left = 1.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -364.0
grow_horizontal = 0

[node name="Margin" type="MarginContainer" parent="./UI/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="./UI/Panel/Margin"]
layout_mode = 2
